# Copy to .env and fill in what you need: cp .env.example .env
# Never commit .env (it's in .gitignore). Every setting is optional; empty means "not used".

# --- Email alerts (scripts/pipeline.py): the result of every pipeline run, and crashes ---
# Same Gmail setup as the data pipeline: a Gmail address + an app password (https://myaccount.google.com/apppasswords)
# e.g. GMAIL_USERNAME=finmlops.alerts@gmail.com
#      GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
#      ALERT_RECIPIENTS=you@northeastern.edu,teammate@northeastern.edu
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
ALERT_RECIPIENTS=

# --- Model registry ---
# GCS bucket a newly promoted champion is copied to (gs://<bucket>/models/finbert-sentiment/v<N>/).
# Needs `gcloud auth application-default login` with an account that has access to the bucket.
MODEL_BUCKET=finmlops-models
# A shared MLflow server instead of the local mlflow.db, so teammates and CI see the same runs and champion.
MLFLOW_TRACKING_URI=

# --- Hardware ---
# Picked automatically (NVIDIA GPU, then Apple Silicon GPU, then CPU). Set to cpu, mps or cuda to force one,
# e.g. TORCH_DEVICE=cpu if the Mac GPU misbehaves.
TORCH_DEVICE=

# --- LLM labels (scripts/llm_labels.py, scripts/label_gold.py) ---
# Free Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Gemini model; empty uses the default in scripts/config.py. Each model has its own free daily quota.
LLM_MODEL=
# Local Ollama server, if it doesn't run on the default address
OLLAMA_HOST=http://localhost:11434

# --- Dashboard (frontend/server.py) ---
HOST=127.0.0.1
PORT=8000
